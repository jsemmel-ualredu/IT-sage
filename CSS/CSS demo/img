/* ---------------Box Sizing----------------- */
html {
  box-sizing: border-box;
}
*,
*:before,
*:after {
  box-sizing: inherit;
}
body{ 
  font-family: "Rubik", sans-serif;
  background-color:#101240;
}
main{
  background-color:#fff;
  width:80vw;
  margin: 40px auto;
  border: 3px solid #0a96a6;
  border-radius:4px;
}

header.primary{
background-color: #8fbdd9;
background-image:
url("https: //assets .codepen .io/ 7248px /bg;")
}

header.primary h1{ 
  margin:0;

}
